{
  "name": "electron-lark",
  "version": "1.1.7",
  "main": "src/main.js",
  "description": "An Electron application for Feishu(Lark)",
  "author": "Ericwyn <ericwyn@meetwhy.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/RichieMay/electron-lark.git"
  },
  "keywords": [
    "Electron",
    "Feishu",
    "Lark",
    "飞书"
  ],
  "bugs": "https://github.com/RichieMay/electron-lark/issues",
  "homepage": "https://github.com/RichieMay/electron-lark",
  "scripts": {
    "start": "electron ."
  },
  "devDependencies": {
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.richiemay.electron-lark",
    "productName": "ElectronLark",
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ElectronLark",
      "deleteAppDataOnUninstall": true
    },
    "linux": {
      "category": "Office",
      "packageCategory": "Office",
      "synopsis": "An Electron application for Feishu(Lark)",
      "icon": "./build/icons",
      "target": [
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "desktop": {
        "entry": {
          "Encoding": "UTF-8"
        }
      }
    }
  },
  "dependencies": {
    "electron-context-menu": "^5.1.0"
  }
}
